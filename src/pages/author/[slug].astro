---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ItemCard from '../../components/ItemCard.astro';
import Logo from '../../components/Logo.astro';
import Icon from '../../components/Icon.astro';
import { SITE, AUTHORS, authorFor, type Person } from '../../data/site';
import { liveArticles, articleUrl } from '../../lib/content';
export const getStaticPaths = () => Object.values(AUTHORS).map((a) => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props as { a: Person };
const items = (await liveArticles()).filter((x) => authorFor(x.data).slug === a.slug);
const schema = a.isPerson
  ? { '@context': 'https://schema.org', '@type': 'ProfilePage', mainEntity: { '@type': 'Person', name: a.name, jobTitle: a.role, url: `${SITE.url}/author/${a.slug}/`, ...(a.linkedin ? { sameAs: [a.linkedin] } : {}), ...(a.photo ? { image: `${SITE.url}${a.photo}` } : {}) } }
  : { '@context': 'https://schema.org', '@type': 'AboutPage', name: a.name, about: { '@id': `${SITE.url}/#org` } };
---
<Base title={`${a.name} | ${SITE.name}`} description={a.bio} jsonld={[schema]}>
  <div class="page-head"><div class="wrap">
    <Breadcrumbs items={[[a.name]]} />
    <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap">
      {a.photo ? <img src={a.photo} alt={a.name} width="120" height="120" style="border-radius:60px" /> : <Logo size={120} />}
      <div style="flex:1 1 400px;display:flex;flex-direction:column;gap:8px">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap"><h1 style="margin:0">{a.name}</h1>{a.linkedin && <a class="li-btn" href={a.linkedin} rel="me noopener" target="_blank" aria-label={`${a.name} on LinkedIn`} style="font-size:14px;padding:6px 12px"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#fff" d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.84-2.05 3.8-2.05 4.06 0 4.8 2.67 4.8 6.15V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z"/></svg>LinkedIn</a>}</div>
        <span class="muted">{[a.role, ...a.credentials].join(', ')}</span>
        <p class="lead">{a.bio}</p>
      </div>
    </div>
  </div></div>
  <div class="wrap section">
    <h2 class="h2">Articles</h2>
    {items.length > 0 ? <div class="grid" style="--min:300px">{items.map((x) => <ItemCard href={articleUrl(x)} title={x.data.title} />)}</div> : <p class="empty">Articles will appear here once published.</p>}
  </div>
</Base>
