---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Icon from '../../../components/Icon.astro';
import { SITE } from '../../../data/site';
import { SERIES, type Series } from '../../../data/series';
import { getDiscipline } from '../../../data/disciplines';
import { liveLessons, lessonUrl, type Lesson } from '../../../lib/content';
export async function getStaticPaths() {
  const lessons = await liveLessons();
  return SERIES.map((s) => ({ params: { series: s.slug }, props: { s, lessons: lessons.filter((l) => l.data.series === s.slug) } })).filter((x) => x.props.lessons.length > 0);
}
const { s, lessons } = Astro.props as { s: Series; lessons: Lesson[] };
const d = getDiscipline(s.discipline)!;
---
<Base title={`${s.title}: ${lessons.length} Lessons | ${SITE.name}`} description={s.description}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'ItemList', name: s.title, itemListElement: lessons.map((l, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}${lessonUrl(l)}`, name: l.data.title })) }]}>
  <div class="page-head"><div class="wrap">
    <Breadcrumbs items={[['Tutorials and Guides', '/tutorials/'], [s.title]]} />
    <div style="display:flex;gap:8px"><span class={`chip chip-fam fam-${d.family}`}>{d.name}</span><span class="chip">{s.difficulty}</span><span class="chip chip-navy">{lessons.length} lessons</span></div>
    <h1>{s.title}</h1>
    <p class="lead">{s.description}</p>
    <a class="btn btn-primary" href={lessonUrl(lessons[0])} style="align-self:flex-start">Start lesson 1 <Icon name="arrow" size={16} stroke={2} /></a>
  </div></div>
  <div class="wrap section" style="max-width:820px">
    <h2 class="h2">Lessons</h2>
    <ol class="lesson-list">
      {lessons.map((l) => <li><a href={lessonUrl(l)} style="padding:14px 10px;border-bottom:1px solid var(--ze-line);border-radius:0"><span class="num">{l.data.order}</span><span style="display:flex;flex-direction:column"><b style="color:var(--ze-navy)">{l.data.title}</b><span class="muted" style="font-size:14px">{l.data.description}</span></span></a></li>)}
    </ol>
  </div>
</Base>
