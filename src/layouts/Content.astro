---
// Shared layout for article-like pages: articles, lessons, interview sets, projects, resources.
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Toc from '../components/Toc.astro';
import AuthorBox from '../components/AuthorBox.astro';
import Faq from '../components/Faq.astro';
import References from '../components/References.astro';
import ShareBar from '../components/ShareBar.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import Logo from '../components/Logo.astro';
import type { MarkdownHeading } from 'astro';
import { SITE, authorFor, REVIEWER_DEFAULT } from '../data/site';
import { getDiscipline } from '../data/disciplines';
import { formatDate } from '../lib/content';
import diagrams from '../../public/images/diagrams/manifest.json';

interface Props {
  data: any; // the entry's data (common fields)
  crumbs: [string, string?][];
  headings: MarkdownHeading[];
  chips?: { label: string; cls?: string; href?: string }[];
  type: string; // for search filters: Article, Tutorial, Interview, Project, Resource
  schemaType?: string;
}
const { data, crumbs, headings, chips = [], type, schemaType = 'Article' } = Astro.props;
const d = getDiscipline(data.discipline)!;
const author = authorFor(data);
const reviewer = data.reviewedDate ? data.reviewedBy ?? REVIEWER_DEFAULT : null;
const url = new URL(Astro.url.pathname, SITE.url).href;
const image = data.image ? new URL(data.image.src.replace(/\.webp$/, '.jpg'), SITE.url).href : undefined;
const dgm: { src: string; alt: string; width: number; height: number }[] = (diagrams as any)[Astro.url.pathname] ?? [];
const images = [...(image ? [image] : []), ...dgm.map((x) => ({ '@type': 'ImageObject', contentUrl: new URL(x.src, SITE.url).href, caption: x.alt, width: x.width, height: x.height }))];
const schema = {
  '@context': 'https://schema.org', '@type': schemaType, headline: data.title, description: data.description,
  datePublished: data.pubDate.toISOString(), dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  mainEntityOfPage: url, ...(images.length ? { image: images.length === 1 ? images[0] : images } : {}),
  author: author.isPerson
    ? { '@type': 'Person', name: author.name, url: `${SITE.url}/author/${author.slug}/`, ...(author.linkedin ? { sameAs: [author.linkedin] } : {}) }
    : { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@id': `${SITE.url}/#org` },
};
---
<Base title={((t) => (`${t} | ${SITE.name}`.length <= 65 ? `${t} | ${SITE.name}` : t))(data.seoTitle ?? data.title)} description={data.description} ogType="article"
  image={data.image?.src.replace(/\.webp$/, '.jpg')} jsonld={[schema]} math={data.math}>
  <div class="wrap" style="padding-top:20px"><Breadcrumbs items={crumbs} /></div>
  <div class="wrap layout">
    <article class="main" data-pagefind-body data-pagefind-filter={`type:${type}`} data-pagefind-meta={`discipline:${d.short}`}>
      <span data-pagefind-filter="discipline" hidden>{d.short}</span>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px" data-pagefind-ignore>
        <a class={`chip chip-fam fam-${d.family}`} href={`/${d.slug}/`}>{d.name}</a>
        {chips.map((c) => (c.href ? <a class={`chip ${c.cls ?? ''}`} href={c.href}>{c.label}</a> : <span class={`chip ${c.cls ?? ''}`}>{c.label}</span>))}
      </div>
      {!data.reviewedDate && <div data-pagefind-ignore style="background:#fff7ed;border:1px solid #f5b800;color:#7a4b00;border-radius:8px;padding:8px 12px;font-size:14px;font-weight:600;margin-bottom:12px">Draft: awaiting technical review</div>}
      <h1 style="margin:0;font-size:var(--ze-h1)">{data.title}</h1>
      <div class="byline" style="margin-top:14px" data-pagefind-ignore>
        {author.photo ? <img src={author.photo} alt="" width="40" height="40" /> : <Logo size={40} class="mark" />}
        <span><a href={`/author/${author.slug}/`} style="font-weight:600">{author.name}</a></span>
        {reviewer && <span>Reviewed by {reviewer}</span>}
        <span>Published <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time></span>
        {data.updatedDate && <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>}
      </div>
      <ShareBar url={url} title={data.title} image={image} />
      {data.image && (
        <figure style="margin:20px 0 0">
          <img src={data.image.src} alt={data.image.alt} width="1200" height="630" style="width:100%;height:auto;border-radius:var(--ze-radius);display:block" fetchpriority="high" />
        </figure>
      )}
      <slot name="top" />
      <div class="prose" style="margin-top:20px"><slot /></div>
      <slot name="after" />
      <div class="prose" style="margin-top:12px"><Faq items={data.faq} /><References items={data.references} /></div>
      <Newsletter variant="inline" />
      <AdSlot slot="endOfArticle" />
      <AuthorBox a={author} />
    </article>
    <aside class="side" data-pagefind-ignore>
      <slot name="side" />
      <Toc headings={headings} />
      <AdSlot slot="sidebar" minHeight={600} />
    </aside>
  </div>
  <slot name="below" />
<Newsletter variant="popup" />
<script>
  // One view per article per browser per day (see public/api/views.php).
  try {
    const p = location.pathname, k = 'zv:' + p, today = new Date().toDateString();
    if (/^\/[a-z0-9-]+\/[a-z0-9-]+\/$/.test(p) && !navigator.webdriver && localStorage.getItem(k) !== today) {
      localStorage.setItem(k, today);
      navigator.sendBeacon('/api/views.php', new URLSearchParams({ p }));
    }
  } catch {}
</script>
<script>
  document.querySelectorAll('figure.anim').forEach((f) => {
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'anim-toggle'; b.textContent = 'Pause';
    b.setAttribute('aria-label', 'Pause or play the animation');
    b.addEventListener('click', () => { const p = f.classList.toggle('paused'); b.textContent = p ? 'Play' : 'Pause'; });
    f.appendChild(b);
  });
</script>
</Base>
