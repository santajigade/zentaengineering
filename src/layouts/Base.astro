---
import '@fontsource-variable/open-sans';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string; // full <title>
  description?: string;
  noindex?: boolean;
  image?: string; // social image path (1200x630)
  ogType?: 'website' | 'article';
  jsonld?: object[]; // page-specific structured data
  math?: boolean; // load KaTeX styles
}
const { title, description = SITE.description, noindex = false, image, ogType = 'website', jsonld = [], math = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const robots = !SITE.launched || noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const ogImage = new URL(image ?? '/brand/og-default.png', SITE.url).href;
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${SITE.url}/#org`, name: SITE.name, url: SITE.url,
  logo: `${SITE.url}/brand/zenta-engineering-mark.svg`, email: SITE.email,
};
const site = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: SITE.url, publisher: { '@id': `${SITE.url}/#org` } };
const schemas = Astro.url.pathname === '/' ? [org, site, ...jsonld] : [org, ...jsonld];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b2545" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {SITE.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
    )}
    {SITE.ga4 && (
      <script is:inline define:vars={{ id: SITE.ga4 }}>
        // GA4 loads after the first interaction or 4 s, to protect page speed.
        let done = false;
        const load = () => { if (done) return; done = true;
          const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id; document.head.appendChild(s);
          window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); }; gtag('js', new Date()); gtag('config', id); };
        ['scroll', 'pointerdown', 'keydown'].forEach((e) => addEventListener(e, load, { once: true, passive: true }));
        setTimeout(load, 4000);
      </script>
    )}
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
