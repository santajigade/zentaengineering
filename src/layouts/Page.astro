---
// Layout for simple Markdown pages (policies, about).
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';
const { frontmatter } = Astro.props;
---
<Base title={`${frontmatter.title} | ${SITE.name}`} description={frontmatter.description}>
  <div class="wrap" style="max-width:800px;padding-top:20px;padding-bottom:24px">
    <Breadcrumbs items={[[frontmatter.title]]} />
    <h1 style="font-size:var(--ze-h1);margin:16px 0 4px">{frontmatter.title}</h1>
    {frontmatter.updated && <p class="muted" style="margin:0;font-size:14px">Last updated {frontmatter.updated}</p>}
    <div class="prose" style="margin-top:24px"><slot /></div>
  </div>
</Base>
