---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faqs">
    <h2 id="faqs">Frequently asked questions</h2>
    {items.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
)}
