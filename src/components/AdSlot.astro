---
// One ad position. Renders nothing unless AdSense is configured and the slot is on in SITE.ads.
import { SITE } from '../data/site';
interface Props { slot: keyof typeof SITE.ads; adId?: string; minHeight?: number }
const { slot, adId = '', minHeight = 280 } = Astro.props;
const on = SITE.ads[slot];
const live = on && SITE.adsenseClient && adId;
const ph = on && !live && SITE.showAdPlaceholders;
---
{live && (
  <div class="ad not-prose" style={`min-height:${minHeight}px`} data-pagefind-ignore>
    <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={SITE.adsenseClient} data-ad-slot={adId} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
{ph && <div class="ad ad-ph not-prose" style={`min-height:${minHeight}px`} data-pagefind-ignore>Ad slot: {slot}</div>}
