---
// Share buttons (plain links, no third-party scripts or trackers).
import { siWhatsapp, siFacebook, siX, siTelegram, siReddit, siPinterest } from 'simple-icons';
interface Props { url: string; title: string; image?: string }
const { url, title, image } = Astro.props;
const u = encodeURIComponent(url), t = encodeURIComponent(title);
const li = 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.84-2.05 3.8-2.05 4.06 0 4.8 2.67 4.8 6.15V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z';
const mail = 'M2 5h20v14H2zm2 2v.5l8 5 8-5V7l-8 5z';
const nets = [
  ['WhatsApp', siWhatsapp.path, '#25D366', `https://wa.me/?text=${t}%20${u}`],
  ['LinkedIn', li, '#0A66C2', `https://www.linkedin.com/sharing/share-offsite/?url=${u}`],
  ['Facebook', siFacebook.path, '#0866FF', `https://www.facebook.com/sharer/sharer.php?u=${u}`],
  ['X', siX.path, '#000000', `https://x.com/intent/post?url=${u}&text=${t}`],
  ['Telegram', siTelegram.path, '#26A5E4', `https://t.me/share/url?url=${u}&text=${t}`],
  ['Reddit', siReddit.path, '#FF4500', `https://www.reddit.com/submit?url=${u}&title=${t}`],
  ['Pinterest', siPinterest.path, '#BD081C', `https://pinterest.com/pin/create/button/?url=${u}&description=${t}${image ? `&media=${encodeURIComponent(image)}` : ''}`],
  ['Email', mail, '#5f6b7a', `mailto:?subject=${t}&body=${t}%0A${u}`],
];
---
<div class="share" data-pagefind-ignore>
  <span class="share-l">Share</span>
  {nets.map(([name, path, color, href]) => (
    <a class="share-b" href={href} target={name === 'Email' ? undefined : '_blank'} rel="noopener nofollow" aria-label={`Share on ${name}`} title={name} style={`--c:${color}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={path} fill="currentColor" /></svg>
    </a>
  ))}
  <button type="button" class="share-b share-copy" data-url={url} aria-label="Copy link" title="Copy link" style="--c:#0b2545">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 005.66 0l3-3a4 4 0 00-5.66-5.66l-1 1M14 10a4 4 0 00-5.66 0l-3 3a4 4 0 005.66 5.66l1-1" /></svg>
  </button>
  <button type="button" class="share-b share-native" data-url={url} data-title={title} aria-label="More sharing options" title="More" style="--c:#0b2545" hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="5" cy="12" r="2" fill="currentColor" /><circle cx="12" cy="12" r="2" fill="currentColor" /><circle cx="19" cy="12" r="2" fill="currentColor" /></svg>
  </button>
  <span class="share-msg" role="status"></span>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((b) => b.addEventListener('click', async () => {
    const msg = b.parentElement!.querySelector('.share-msg') as HTMLElement;
    try { await navigator.clipboard.writeText(b.dataset.url!); msg.textContent = 'Link copied'; } catch { msg.textContent = b.dataset.url!; }
    setTimeout(() => (msg.textContent = ''), 2500);
  }));
  document.querySelectorAll<HTMLButtonElement>('.share-native').forEach((b) => {
    if (!navigator.share) return;
    b.hidden = false;
    b.addEventListener('click', () => navigator.share({ title: b.dataset.title, url: b.dataset.url }).catch(() => {}));
  });
</script>
