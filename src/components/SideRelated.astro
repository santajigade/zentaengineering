---
// Sidebar: newest articles from the same discipline, with thumbnails.
import { liveArticles, articleUrl, formatDate } from '../lib/content';
interface Props { discipline: string; current: string; name: string }
const { discipline, current, name } = Astro.props;
const items = (await liveArticles()).filter((a) => a.data.discipline === discipline && articleUrl(a) !== current).slice(0, 4);
---
{items.length > 0 && (
  <section class="card side-rel">
    <span class="toc-label">More in {name}</span>
    <ul>
      {items.map((a) => (
        <li><a href={articleUrl(a)}>
          {a.data.image ? <img src={a.data.image.src.replace(/\.webp$/, '-thumb.webp')} alt="" width="96" height="50" loading="lazy" decoding="async" /> : <span class="side-ph" />}
          <span><span class="side-t">{a.data.title}</span><time datetime={a.data.pubDate.toISOString().slice(0, 10)}>{formatDate(a.data.pubDate)}</time></span>
        </a></li>
      ))}
    </ul>
    <a class="side-more" href={`/${discipline}/`}>All {name} articles →</a>
  </section>
)}
