---
import Logo from './Logo.astro';
import { SITE } from '../data/site';
const popular = [
  ['Electrical Engineering', '/electrical-engineering/'], ['Electronics Engineering', '/electronics-engineering/'],
  ['Mechanical Engineering', '/mechanical-engineering/'], ['Automation and Robotics', '/automation-robotics/'],
  ['Renewable Energy', '/renewable-energy/'], ['Chemical Engineering', '/chemical-engineering/'],
];
const learn = [['All categories', '/engineering-categories/'], ['Tutorials and Guides', '/tutorials/'], ['Interview Questions', '/interview-questions/'], ['Engineering Projects', '/projects/'], ['Resources', '/resources/']];
const ICONS: Record<string, [string, string]> = {
  linkedin: ['LinkedIn', 'M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.84-2.05 3.8-2.05 4.06 0 4.8 2.67 4.8 6.15V21h-4v-5.6c0-1.34-.03-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z'],
  facebook: ['Facebook', 'M14 8.5V6.8c0-.8.5-1 1-1h2V2.2h-2.8C11.1 2.2 10 4.3 10 6.4v2.1H7.5V12H10v10h4V12h2.8l.4-3.5z'],
  instagram: ['Instagram', 'M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 4.9a4.9 4.9 0 100 9.8 4.9 4.9 0 000-9.8zm0 8.1a3.2 3.2 0 110-6.4 3.2 3.2 0 010 6.4zm5.1-9.4a1.1 1.1 0 100 2.3 1.1 1.1 0 000-2.3z'],
  youtube: ['YouTube', 'M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 00.5 6.2 31 31 0 000 12a31 31 0 00.5 5.8 3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1A31 31 0 0024 12a31 31 0 00-.5-5.8zM9.6 15.6V8.4l6.3 3.6z'],
};
const social = Object.entries(SITE.social).filter(([, u]) => u);
const about = [['About Us', '/about/'], ['Editorial Policy', '/editorial-policy/'], ['Contact', '/contact/'], ['Privacy Policy', '/privacy-policy/'], ['Terms of Use', '/terms-of-use/'], ['Disclaimer', '/disclaimer/']];
---
<footer class="site-footer">
  <div class="wrap cols">
    <div style="display:flex;flex-direction:column;gap:12px">
      <a href="/" style="display:flex;align-items:center;gap:10px;color:#fff;font-size:18px"><Logo size={32} /><span><b>Zenta</b> Engineering</span></a>
      <p style="margin:0;line-height:1.6">{SITE.tagline}</p>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {social.length > 0 && (
        <div class="social">
          {social.map(([k, u]) => (
            <a href={u} target="_blank" rel="noopener me" aria-label={`Zenta Engineering on ${ICONS[k][0]}`} title={ICONS[k][0]}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={ICONS[k][1]} /></svg>
            </a>
          ))}
        </div>
      )}
    </div>
    <div><h2>Popular disciplines</h2><ul>{popular.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>
    <div><h2>Learn</h2><ul>{learn.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>
    <div><h2>About</h2><ul>{about.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul></div>
  </div>
  <div class="wrap legal" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
    <span>© {new Date().getFullYear()} Zenta Engineering</span>
    <span style="display:flex;gap:16px;flex-wrap:wrap;align-items:center">Our other sites:
      <a href="https://zentacalculator.com/">ZentaCalculator</a>
      <a href="https://zentapdf.com/">ZentaPDF</a>
    </span>
  </div>
</footer>
